<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/rang1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddWallpaperFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/toolbar_add_wall"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="@color/rang2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_btn_add_wall_fg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"/>

        <TextView
            android:id="@+id/toolbar_add_wall_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="60dp"
            android:textColor="@color/white"
            android:text="@string/publish_wallpaper"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_add_wall"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >

                <TextView
                    android:id="@+id/info_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:text="@string/you_should_fill_about_wallpaper"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/enter_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_wallpaper_s_name"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/info_text"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/content_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_wallpaper_s_name"
                    android:textColorHint="@color/white1"
                    android:textColor="@color/white"
                    android:inputType="textCapWords"
                    android:maxLines="2"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    android:layout_marginTop="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/enter_name_text"/>

                <TextView
                    android:id="@+id/enter_designer_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_designer_s_name"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/content_name"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/designer_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_designer_optional"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textSize="16sp"
                    android:textColorHint="@color/white1"
                    android:textColor="@color/white"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/enter_designer_text"/>

                <TextView
                    android:id="@+id/enter_size_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_wallpaper_s_size"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/designer_name"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/content_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textSize="16sp"
                    android:inputType="numberDecimal"
                    android:hint="7.6"
                    android:maxLines="1"
                    android:textColorHint="@color/white1"
                    android:textColor="@color/white"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/enter_size_text" />


                <TextView
                    android:id="@+id/choose_color_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_primary_color"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/content_size"
                    app:layout_constraintStart_toStartOf="parent" />
                <HorizontalScrollView
                    android:id="@+id/nest_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/choose_color_title"
                    >
                    <RadioGroup
                        android:id="@+id/btn_radio_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        />

                </HorizontalScrollView>

                <TextView
                    android:id="@+id/add_wall_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_wallpaper_text"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/nest_scroll"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


                        <TextView
                            android:id="@+id/wallpaper_text_view_1"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/required_image_add"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="60dp"
                            app:layout_constraintTop_toBottomOf="@+id/add_wall_text"
                            app:layout_constraintEnd_toEndOf="@+id/wallpaper_card_view"
                            app:layout_constraintStart_toStartOf="@+id/wallpaper_card_view" />
                        <androidx.cardview.widget.CardView
                            android:id="@+id/wallpaper_card_view"
                            android:layout_width="100dp"
                            android:layout_height="206dp"
                            app:cardElevation="0dp"
                            android:layout_marginTop="3dp"
                            app:cardCornerRadius="12dp"
                            android:backgroundTint="#00FFFFFF"
                            app:layout_constraintTop_toBottomOf="@+id/wallpaper_text_view_1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:id="@+id/wallpaper_image_view"
                                android:layout_width="100dp"
                                android:layout_height="206dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/wall"/>

                        </androidx.cardview.widget.CardView>
                        <TextView
                            android:id="@+id/wallpaper_text_view_2"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/add_wallpaper_on_image"
                            android:gravity="center"
                            android:textSize="10sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="60dp"
                            app:layout_constraintBottom_toBottomOf="@+id/wallpaper_card_view"
                            app:layout_constraintEnd_toEndOf="@+id/wallpaper_card_view"
                            app:layout_constraintStart_toStartOf="@+id/wallpaper_card_view" />



            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                android:layout_marginVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_1"
                >

                <TextView
                    android:id="@+id/how_contact_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/how_can_we_contact_you"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@drawable/background_text"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/how_contact_title"/>



                <EditText
                    android:id="@+id/how_contact_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:inputType="textPhonetic"
                    android:textSize="16sp"
                    android:hint="+9684149316"
                    android:visibility="gone"
                    android:textColorHint="#6A6A6A"
                    android:textColor="@color/white"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/spinner" />

                <Button
                    android:id="@+id/btn_send_wallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/send_content_"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/how_contact_edit_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/btn_send_wallpaper"
                    app:layout_constraintStart_toStartOf="@+id/btn_send_wallpaper"
                    app:layout_constraintBottom_toBottomOf="@+id/btn_send_wallpaper"
                    app:layout_constraintEnd_toEndOf="@+id/btn_send_wallpaper"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>