<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/rang1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddWallpaperFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/toolbar_add_wall"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="@color/rang2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_btn_add_wall_fg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"/>

        <TextView
            android:id="@+id/toolbar_add_wall_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="60dp"
            android:textColor="@color/white"
            android:text="Выбор тарифа"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_add_wall"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="15dp"
            android:layout_margin="10dp"
            android:background="@drawable/cons_background"
            >

            <TextView
                android:id="@+id/subtext_choose_tariff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Наслаждайтесь приложением без отвлекающих рекламных материалов."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/description_choose_tariff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Для отключеневт рекламы выберите и приобретите один из тарифов ниже. После этого вы сможете пользоваться приложением без рекламы в течение срока, указанного в Выбранном вами тарифе"
                android:textSize="16sp"
                android:textColor="@color/white1"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtext_choose_tariff"/>

            <!-- 1 Week Plan -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginTop="10dp"
                android:id="@+id/layout_tariff_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:paddingStart="15dp"
                android:paddingEnd="5dp"
                android:background="@drawable/unselected_tariff"
                app:layout_constraintTop_toBottomOf="@+id/description_choose_tariff">

                <TextView
                    android:id="@+id/tariff_week_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 неделя — 29 рублей"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Короткий пробный период для знакомства с сервисом!"
                    android:textSize="14sp"
                    android:textColor="#B0B0B0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tariff_week_title"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 1 Month Plan -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_tariff_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="8dp"
                android:paddingStart="15dp"
                android:paddingEnd="5dp"
                android:background="@drawable/unselected_tariff"
                app:layout_constraintTop_toBottomOf="@+id/layout_tariff_week"
                >

                <TextView
                    android:id="@+id/tariff_month_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 месяц — 99 рублей"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Месяц комфортного использования без рекламы!"
                    android:textSize="14sp"
                    android:textColor="#B0B0B0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tariff_month_title"
                    />

                <TextView
                    android:id="@+id/tariff_month_sale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="116 рублей"
                    android:textColor="#D91515"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintStart_toEndOf="@+id/tariff_month_title"
                    app:layout_constraintTop_toTopOf="@+id/tariff_month_title"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_month_title"
                    />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#D91515"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toStartOf="@+id/tariff_month_sale"
                    app:layout_constraintBottom_toBottomOf="@id/tariff_month_sale"
                    app:layout_constraintEnd_toEndOf="@+id/tariff_month_sale"
                    app:layout_constraintTop_toTopOf="@+id/tariff_month_sale"
                    />

                <TextView
                    android:id="@+id/tariff_month_procent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15%"
                    android:textColor="#28C52E"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tariff_month_sale"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_month_sale"
                    />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 3 Months Plan -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_tariff_3_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="8dp"
                android:paddingStart="15dp"
                android:paddingEnd="5dp"
                android:background="@drawable/unselected_tariff"
                app:layout_constraintTop_toBottomOf="@+id/layout_tariff_month">

                <TextView
                    android:id="@+id/tariff_3_months_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 месяца — 249 рублей"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Оптимальный выбор для тех, кто ценит удобство!"
                    android:textSize="14sp"
                    android:textColor="#B0B0B0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tariff_3_months_title"
                    />

                <TextView
                    android:id="@+id/tariff_3_months_sale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="297 рублей"
                    android:textColor="#D91515"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintStart_toEndOf="@+id/tariff_3_months_title"
                    app:layout_constraintTop_toTopOf="@+id/tariff_3_months_title"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_3_months_title"
                    />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#D91515"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toStartOf="@+id/tariff_3_months_sale"
                    app:layout_constraintBottom_toBottomOf="@id/tariff_3_months_sale"
                    app:layout_constraintEnd_toEndOf="@+id/tariff_3_months_sale"
                    app:layout_constraintTop_toTopOf="@+id/tariff_3_months_sale"
                    />

                <TextView
                    android:id="@+id/tariff_3_month_procent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16%"
                    android:textColor="#28C52E"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tariff_3_months_sale"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_3_months_sale"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 6 Months Plan -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_tariff_6_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="8dp"
                android:paddingStart="15dp"
                android:paddingEnd="5dp"
                android:background="@drawable/unselected_tariff"
                app:layout_constraintTop_toBottomOf="@+id/layout_tariff_3_month">

                <TextView
                    android:id="@+id/tariff_6_months_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 месяца — 429 рублей"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Полгода полного погружения без рекламы!"
                    android:textSize="14sp"
                    android:textColor="#B0B0B0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tariff_6_months_title"
                    />
                <TextView
                    android:id="@+id/tariff_6_month_sale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="498 рублей"
                    android:textColor="#D91515"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintStart_toEndOf="@+id/tariff_6_months_title"
                    app:layout_constraintTop_toTopOf="@+id/tariff_6_months_title"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_6_months_title"
                    />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#D91515"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toStartOf="@+id/tariff_6_month_sale"
                    app:layout_constraintBottom_toBottomOf="@id/tariff_6_month_sale"
                    app:layout_constraintEnd_toEndOf="@+id/tariff_6_month_sale"
                    app:layout_constraintTop_toTopOf="@+id/tariff_6_month_sale"
                    />

                <TextView
                    android:id="@+id/tariff_6_months_procent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14%"
                    android:textColor="#28C52E"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tariff_6_month_sale"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_6_month_sale"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 1 Year Plan -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_tariff_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="8dp"
                android:paddingStart="15dp"
                android:paddingEnd="5dp"
                android:background="@drawable/unselected_tariff"
                app:layout_constraintTop_toBottomOf="@+id/layout_tariff_6_month">

                <TextView
                    android:id="@+id/tariff_year_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 год — 799 рублей"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Максимальная выгода — весь год без рекламы!"
                    android:textSize="14sp"
                    android:textColor="#B0B0B0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tariff_year_title"
                    />
                <TextView
                    android:id="@+id/tariff_year_sale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="858 рублей"
                    android:textColor="#D91515"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintStart_toEndOf="@+id/tariff_year_title"
                    app:layout_constraintTop_toTopOf="@+id/tariff_year_title"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_year_title"
                    />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#D91515"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toStartOf="@+id/tariff_year_sale"
                    app:layout_constraintBottom_toBottomOf="@id/tariff_year_sale"
                    app:layout_constraintEnd_toEndOf="@+id/tariff_year_sale"
                    app:layout_constraintTop_toTopOf="@+id/tariff_year_sale"
                    />

                <TextView
                    android:id="@+id/tariff_year_procent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7%"
                    android:textColor="#28C52E"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tariff_year_sale"
                    app:layout_constraintBottom_toBottomOf="@+id/tariff_year_sale"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>




                <TextView
                    android:id="@+id/write_email_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="На вашу эл. почту придут код отключения рекламы и чек об оплате"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_tariff_year"
                    />

                <EditText
                    android:id="@+id/edittext_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Введите ваш email"
                    android:background="@drawable/custom_background"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textColorHint="#A4A4A4"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:inputType="textEmailAddress"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/write_email_textview"
                    />

                <EditText
                    android:id="@+id/edittext_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ваше имя (необязательно)"
                    android:textSize="16sp"
                    android:background="@drawable/custom_background"
                    android:textColor="@color/white"
                    android:textColorHint="#A4A4A4"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:inputType="textPersonName"
                    app:layout_constraintTop_toBottomOf="@+id/edittext_email"
                    />

                <CheckBox
                    android:id="@+id/checkbox_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Я соглашаюсь "
                    android:textSize="12sp"
                    android:checked="true"
                    android:textColor="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edittext_name"
                    />
            <TextView
                android:id="@+id/text_checkbox_conditions_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="с условиями использования"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@+id/checkbox_terms"
                app:layout_constraintTop_toTopOf="@id/checkbox_terms"
                app:layout_constraintBottom_toBottomOf="@id/checkbox_terms"
                />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:background="#4CAF50"
                app:layout_constraintStart_toStartOf="@+id/text_checkbox_conditions_link"
                app:layout_constraintBottom_toBottomOf="@id/text_checkbox_conditions_link"
                app:layout_constraintEnd_toEndOf="@+id/text_checkbox_conditions_link"
                />


                <Button
                    android:id="@+id/btn_buy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Купить"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/checkbox_terms"/>



        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>