<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_history_monthly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:id="@+id/tv_month_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="December, 2025"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_monthly_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/income"
            android:textSize="14sp"
            android:maxLines="1"
            android:textStyle="bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@+id/tv_month_name"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tv_income_amount_monthly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_monthly_income"
            android:textColor="@color/green1" />

        <TextView
            android:id="@+id/tv_monthly_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/expense"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@+id/tv_month_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_monthly_income"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_expense_amount_monthly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_monthly_expense"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/red" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/monthly_separate"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/subtext"
        app:layout_constraintTop_toBottomOf="@+id/layout_history_monthly"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_history_weekly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_history_monthly">


        <TextView
            android:id="@+id/tv_week_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="38W"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_weekly_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01.12.25"
            android:textSize="14sp"
            android:maxLines="1"
            android:textStyle="bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@+id/tv_week_number"
            app:layout_constraintTop_toTopOf="parent"
            />

        <View
            android:id="@+id/seperate"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/subtext"
            app:layout_constraintTop_toBottomOf="@+id/tv_weekly_start"
            app:layout_constraintBottom_toTopOf="@+id/tv_weekly_end"
            app:layout_constraintStart_toStartOf="@+id/tv_weekly_start"
            app:layout_constraintEnd_toEndOf="@+id/tv_weekly_start"
            />

        <TextView
            android:id="@+id/tv_weekly_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="07.12.25"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@+id/tv_week_number"
            app:layout_constraintTop_toBottomOf="@+id/tv_weekly_start"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_weekly_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/income"
            android:textSize="14sp"
            android:maxLines="1"
            android:textStyle="bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@+id/tv_weekly_start"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tv_income_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_weekly_income"
            android:textColor="@color/green1" />

        <TextView
            android:id="@+id/tv_weekly_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/expense"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@+id/tv_weekly_end"
            app:layout_constraintTop_toBottomOf="@+id/tv_weekly_start"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_expense_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_weekly_expense"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/red" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/weekly_separate"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/subtext"
        app:layout_constraintTop_toBottomOf="@+id/layout_history_weekly"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:paddingHorizontal="10dp"
        android:background="#ABC5B4"
        app:layout_constraintTop_toBottomOf="@+id/layout_history_weekly"
        >

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19.10.2025"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tv_total_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_history_daily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_date">

        <ImageView
            android:id="@+id/image_item_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/baseline_edit_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <TextView
            android:id="@+id/tv_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Breakfast"
            android:textSize="14sp"
            android:maxLines="1"
            android:textStyle="bold"
            android:ellipsize="end"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/image_item_history"
            app:layout_constraintTop_toTopOf="@+id/image_item_history"
            app:layout_constraintBottom_toTopOf="@+id/tv_type_description"
            />

        <TextView
            android:id="@+id/tv_type_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="egg and juice"
            android:textSize="12sp"

            app:layout_constraintEnd_toStartOf="@+id/tv_amount"
            app:layout_constraintStart_toStartOf="@+id/tv_type_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_type_title"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:ellipsize="end"
            android:gravity="end"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.40"
            android:textColor="@color/green1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/daily_separate"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/subtext"
        app:layout_constraintTop_toBottomOf="@+id/layout_history_daily"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>