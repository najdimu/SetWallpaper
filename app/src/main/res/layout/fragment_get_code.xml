<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rang1"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".GetCodeFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/toolbar_get_code_fg"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="@color/rang2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_btn_get_code_fg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"/>

        <TextView
            android:id="@+id/get_code_fg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="60dp"
            android:textColor="@color/white"
            android:text="Получить код"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.cardview.widget.CardView>



    <androidx.cardview.widget.CardView
        android:id="@+id/chosen_tariff_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/rang2"
        android:visibility="gone"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_get_code_fg"

        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/chosen_tariff_Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:text="Вы выбрали: 1 Месяц"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/chosen_tariff_Price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="5dp"
                android:textColor="@color/white"
                android:text="Стоимость: 99 рублей"
                app:layout_constraintTop_toBottomOf="@+id/chosen_tariff_Title"
                />

            <TextView
                android:id="@+id/chosen_tariff_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="5dp"
                android:textColor="@color/white"
                android:text="Тариф не активирован"
                app:layout_constraintTop_toBottomOf="@+id/chosen_tariff_Price"/>

            <Button
                android:id="@+id/btn_checking_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Чековый платеж"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/chosen_tariff_status"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_get_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Получить код"
        android:layout_marginBottom="15dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>