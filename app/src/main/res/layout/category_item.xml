<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_category_item"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/title_item_category"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/salary"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="8dp"
        android:paddingStart="70dp"
        android:paddingEnd="5dp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/icon_item_category"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="25dp"
        android:src="@drawable/baseline_edit_24"
        app:layout_constraintTop_toTopOf="@+id/title_item_category"
        app:layout_constraintStart_toStartOf="@+id/title_item_category"
        app:layout_constraintBottom_toBottomOf="@+id/title_item_category"
        />


</androidx.constraintlayout.widget.ConstraintLayout>