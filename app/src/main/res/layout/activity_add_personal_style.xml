<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_personal_style_activity_layout"
    android:background="#1a1a1a"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".style_zone.activity.AddPersonalStyleActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_add_personal_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#272727"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_add_personal_style"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >

                <TextView
                    android:id="@+id/text_about_perStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:text="About personal style"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_perStyle"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Title"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:maxLength="40"
                    android:textSize="16sp"
                    android:textColorHint="#b6b6b6"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="5dp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_text"/>

                <TextView
                    android:id="@+id/description_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_title"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_description"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="5dp"
                    android:textSize="16sp"
                    android:inputType="textCapSentences"
                    android:hint="Please describe your personal style"
                    android:maxLines="10"
                    android:gravity="top"
                    android:textColorHint="#b6b6b6"
                    android:textColor="#ffffff"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description_text" />


                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/add_screenshots_1"
                    android:layout_width="90dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:background="#373737"
                    android:layout_marginTop="20dp"
                    android:padding="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_description"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#6F6F6F"
                    app:strokeWidth="2dp"
                    />

                <ImageView
                    android:id="@+id/ic_add_screenshots_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/outline_add_photo_alternate_24"
                    android:layout_marginTop="35dp"
                    app:layout_constraintTop_toTopOf="@+id/add_screenshots_1"
                    app:layout_constraintEnd_toEndOf="@+id/add_screenshots_1"
                    app:layout_constraintStart_toStartOf="@+id/add_screenshots_1"
                    />
                <TextView
                    android:id="@+id/text_add_screenshots_1"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Screenshots"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    app:layout_constraintTop_toBottomOf="@+id/ic_add_screenshots_1"
                    app:layout_constraintEnd_toEndOf="@+id/ic_add_screenshots_1"
                    app:layout_constraintStart_toStartOf="@+id/ic_add_screenshots_1" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/add_screenshots_2"
                    android:layout_width="90dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:background="#373737"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="10dp"
                    android:padding="2dp"
                    app:layout_constraintStart_toEndOf="@+id/add_screenshots_1"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_description"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#6F6F6F"
                    app:strokeWidth="2dp"
                    />
                <ImageView
                    android:id="@+id/ic_add_screenshots_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/outline_add_photo_alternate_24"
                    android:layout_marginTop="35dp"
                    app:layout_constraintTop_toTopOf="@+id/add_screenshots_2"
                    app:layout_constraintEnd_toEndOf="@+id/add_screenshots_2"
                    app:layout_constraintStart_toStartOf="@+id/add_screenshots_2"
                    />
                <TextView
                    android:id="@+id/text_add_screenshots_2"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Screenshots"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    app:layout_constraintTop_toBottomOf="@+id/ic_add_screenshots_2"
                    app:layout_constraintEnd_toEndOf="@+id/ic_add_screenshots_2"
                    app:layout_constraintStart_toStartOf="@+id/ic_add_screenshots_2" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/add_screenshots_3"
                    android:layout_width="90dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:background="#373737"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="10dp"
                    android:padding="2dp"
                    app:layout_constraintStart_toEndOf="@+id/add_screenshots_2"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_description"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#6F6F6F"
                    app:strokeWidth="2dp"
                    />
                <ImageView
                    android:id="@+id/ic_add_screenshots_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/outline_add_photo_alternate_24"
                    android:layout_marginTop="35dp"
                    app:layout_constraintTop_toTopOf="@+id/add_screenshots_3"
                    app:layout_constraintEnd_toEndOf="@+id/add_screenshots_3"
                    app:layout_constraintStart_toStartOf="@+id/add_screenshots_3"
                    />
                <TextView
                    android:id="@+id/text_add_screenshots_3"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Screenshots"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    app:layout_constraintTop_toBottomOf="@+id/ic_add_screenshots_3"
                    app:layout_constraintEnd_toEndOf="@+id/ic_add_screenshots_3"
                    app:layout_constraintStart_toStartOf="@+id/ic_add_screenshots_3" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                android:layout_marginVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_1"
                >

                <TextView
                    android:id="@+id/text_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    android:text="About source"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/text_source_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theme"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/edit_text_source_theme"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_source_theme"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Paste theme's link"
                    android:textColorHint="#B6B6B6"
                    android:textColor="#FFFFFF"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_source"/>

                <TextView
                    android:id="@+id/text_source_wallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wallpaper"
                    android:visibility="gone"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/edit_text_source_wallpaper"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_source_wallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Paste wallpaper's link"
                    android:textColorHint="#B6B6B6"
                    android:textColor="#FFFFFF"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_theme"/>

                <TextView
                    android:id="@+id/text_source_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Icon"
                    android:visibility="gone"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/edit_text_source_icon"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_source_icon"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Paste icon's link"
                    android:textColorHint="#B6B6B6"
                    android:textColor="#FFFFFF"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_wallpaper"/>

                <TextView
                    android:id="@+id/text_source_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Font"
                    android:visibility="gone"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/edit_text_source_font"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_source_font"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Paste font's link"
                    android:textColorHint="#B6B6B6"
                    android:textColor="#FFFFFF"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_icon"/>

                <Spinner
                    android:id="@+id/spinner_source_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@drawable/background_text"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_font"/>

                <TextView
                    android:id="@+id/which_device_support_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Which device does it support?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/spinner_source_link"
                    app:layout_constraintStart_toStartOf="parent" />

                <Spinner
                    android:id="@+id/spinner_device_support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@drawable/background_text"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/which_device_support_text"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                android:layout_marginVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_2"
                >

                <TextView
                    android:id="@+id/text_about_user"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    android:text="About author"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/user_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_user"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_username"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Author"
                    android:textColorHint="#B6B6B6"
                    android:textColor="#FFFFFF"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:maxLength="40"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    android:layout_marginTop="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_name_text"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:background="#373737"
                    android:src="@drawable/baseline_add_20"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="15dp"
                    android:padding="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_username"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#9E9E9E"
                    app:strokeWidth="1dp"
                    />

                <TextView
                    android:id="@+id/user_avatar_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add avatar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="@+id/user_avatar"
                    app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
                    app:layout_constraintStart_toEndOf="@+id/user_avatar"
                    />

                <Button
                    android:id="@+id/btn_send_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_username"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/btn_send_content"
                    app:layout_constraintStart_toStartOf="@+id/btn_send_content"
                    app:layout_constraintBottom_toBottomOf="@+id/btn_send_content"
                    app:layout_constraintEnd_toEndOf="@+id/btn_send_content"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/textView_request_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#ffffff"
        android:paddingHorizontal="20dp"
        android:paddingVertical="5dp"
        android:gravity="center"
        android:background="@drawable/request_text_background"
        android:visibility="gone"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_add_personal_style"/>


</androidx.constraintlayout.widget.ConstraintLayout>