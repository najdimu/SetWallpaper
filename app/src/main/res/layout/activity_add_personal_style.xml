<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_personal_style_activity_layout"
    android:background="#1a1a1a"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".style_zone.activity.AddPersonalStyleActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_add_personal_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#272727"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_add_personal_style"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >

                <TextView
                    android:id="@+id/text_about_perStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:text="@string/about_personal_style"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_perStyle"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="@string/title"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:maxLength="40"
                    android:textSize="16sp"
                    android:textColorHint="#b6b6b6"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="5dp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_text"/>

                <TextView
                    android:id="@+id/description_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/description"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_title"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_description"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="5dp"
                    android:textSize="16sp"
                    android:inputType="textCapSentences"
                    android:hint="@string/hint_describe_style"
                    android:maxLines="10"
                    android:gravity="top"
                    android:textColorHint="#b6b6b6"
                    android:textColor="#ffffff"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description_text" />



            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                android:layout_marginVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_1"
                >

                <TextView
                    android:id="@+id/text_about_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    android:text="@string/about_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/text_source_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:visibility="visible"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_content"
                    app:layout_constraintStart_toStartOf="parent" />
                <ImageView
                    android:id="@+id/btn_gone_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/delete_24px"
                    android:layout_marginStart="7dp"
                    app:layout_constraintStart_toEndOf="@+id/text_source_theme"
                    app:layout_constraintTop_toTopOf="@+id/text_source_theme"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_theme"/>

                <TextView
                    android:id="@+id/edit_text_source_theme"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:text="@string/hint_theme_s_link"
                    android:textColor="#B6B6B6"
                    android:maxLines="1"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/text_link_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_paste_theme_link"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_theme"/>
                <Button
                    android:id="@+id/btn_paste_theme_link"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:text="Paste"
                    android:background="@drawable/paste_btn_background"
                    app:backgroundTint="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/edit_text_source_theme"
                    app:layout_constraintBottom_toBottomOf="@+id/edit_text_source_theme"/>

                <TextView
                    android:id="@+id/text_source_wallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpaper"
                    android:visibility="visible"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_theme"
                    app:layout_constraintStart_toStartOf="parent" />
                <ImageView
                    android:id="@+id/btn_gone_wall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/delete_24px"
                    android:layout_marginStart="7dp"
                    app:layout_constraintStart_toEndOf="@+id/text_source_wallpaper"
                    app:layout_constraintTop_toTopOf="@+id/text_source_wallpaper"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_wallpaper"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/add_home_wall"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerInside"
                    android:background="#373737"
                    android:src="@drawable/baseline_add_20"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="15dp"
                    android:padding="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_wallpaper"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#9E9E9E"
                    app:strokeWidth="1dp"
                    />
                <TextView
                    android:id="@+id/add_home_wall_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_home_wall"
                    android:textColor="#F6F6F6"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="@+id/add_home_wall"
                    app:layout_constraintBottom_toBottomOf="@+id/add_home_wall"
                    app:layout_constraintStart_toEndOf="@+id/add_home_wall"
                    />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/add_lock_wall"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerInside"
                    android:background="#373737"
                    android:src="@drawable/baseline_add_20"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    android:padding="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/add_home_wall"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#9E9E9E"
                    app:strokeWidth="1dp"
                    />
                <TextView
                    android:id="@+id/add_lock_wall_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_lock_wall"
                    android:textColor="#F6F6F6"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="@+id/add_lock_wall"
                    app:layout_constraintBottom_toBottomOf="@+id/add_lock_wall"
                    app:layout_constraintStart_toEndOf="@+id/add_lock_wall"
                    />

                <TextView
                    android:id="@+id/text_source_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon"
                    android:visibility="visible"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/add_lock_wall"
                    app:layout_constraintStart_toStartOf="parent" />
                <ImageView
                    android:id="@+id/btn_gone_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/delete_24px"
                    android:layout_marginStart="5dp"
                    app:layout_constraintStart_toEndOf="@+id/text_source_icon"
                    app:layout_constraintTop_toTopOf="@+id/text_source_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_icon"/>

                <TextView
                    android:id="@+id/edit_text_source_icon"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:text="@string/hint_theme_s_link"
                    android:textColor="#B6B6B6"
                    android:maxLines="1"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/text_link_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_paste_icon_link"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_icon"/>
                <Button
                    android:id="@+id/btn_paste_icon_link"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:text="Paste"
                    android:background="@drawable/paste_btn_background"
                    app:backgroundTint="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/edit_text_source_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/edit_text_source_icon"/>

                <TextView
                    android:id="@+id/text_source_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/font"
                    android:visibility="visible"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_icon"
                    app:layout_constraintStart_toStartOf="parent" />
                <ImageView
                    android:id="@+id/btn_gone_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/delete_24px"
                    android:layout_marginStart="5dp"
                    app:layout_constraintStart_toEndOf="@+id/text_source_font"
                    app:layout_constraintTop_toTopOf="@+id/text_source_font"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_font"/>

                <TextView
                    android:id="@+id/edit_text_source_font"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:text="@string/hint_theme_s_link"
                    android:textColor="#B6B6B6"
                    android:maxLines="1"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/text_link_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_paste_font_link"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_font"/>
                <Button
                    android:id="@+id/btn_paste_font_link"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:text="Paste"
                    android:background="@drawable/paste_btn_background"
                    app:backgroundTint="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/edit_text_source_font"
                    app:layout_constraintBottom_toBottomOf="@+id/edit_text_source_font"/>

                <Spinner
                    android:id="@+id/spinner_type_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@drawable/background_text"
                    android:layout_marginTop="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_font"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_theme_screenshots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/spinner_type_content"
                    >

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/add_screenshots_1"
                        android:layout_width="90dp"
                        android:layout_height="110dp"
                        android:scaleType="centerCrop"
                        android:background="#373737"
                        android:layout_marginTop="10dp"
                        android:padding="2dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/avatarThemes"
                        app:strokeColor="#6F6F6F"
                        app:strokeWidth="2dp"
                        />
                    <ImageView
                        android:id="@+id/ic_add_screenshots_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/outline_add_photo_alternate_24"
                        android:layout_marginTop="35dp"
                        app:layout_constraintTop_toTopOf="@+id/add_screenshots_1"
                        app:layout_constraintEnd_toEndOf="@+id/add_screenshots_1"
                        app:layout_constraintStart_toStartOf="@+id/add_screenshots_1"
                        />
                    <TextView
                        android:id="@+id/text_add_screenshots_1"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_screenshots"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        app:layout_constraintTop_toBottomOf="@+id/ic_add_screenshots_1"
                        app:layout_constraintEnd_toEndOf="@+id/ic_add_screenshots_1"
                        app:layout_constraintStart_toStartOf="@+id/ic_add_screenshots_1" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/add_screenshots_2"
                        android:layout_width="90dp"
                        android:layout_height="110dp"
                        android:scaleType="centerCrop"
                        android:background="#373737"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:padding="2dp"
                        app:layout_constraintStart_toEndOf="@+id/add_screenshots_1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/avatarThemes"
                        app:strokeColor="#6F6F6F"
                        app:strokeWidth="2dp"
                        />
                    <ImageView
                        android:id="@+id/ic_add_screenshots_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/outline_add_photo_alternate_24"
                        android:layout_marginTop="35dp"
                        app:layout_constraintTop_toTopOf="@+id/add_screenshots_2"
                        app:layout_constraintEnd_toEndOf="@+id/add_screenshots_2"
                        app:layout_constraintStart_toStartOf="@+id/add_screenshots_2"
                        />
                    <TextView
                        android:id="@+id/text_add_screenshots_2"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_screenshots"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        app:layout_constraintTop_toBottomOf="@+id/ic_add_screenshots_2"
                        app:layout_constraintEnd_toEndOf="@+id/ic_add_screenshots_2"
                        app:layout_constraintStart_toStartOf="@+id/ic_add_screenshots_2" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/add_screenshots_3"
                        android:layout_width="90dp"
                        android:layout_height="110dp"
                        android:scaleType="centerCrop"
                        android:background="#373737"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:padding="2dp"
                        app:layout_constraintStart_toEndOf="@+id/add_screenshots_2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/avatarThemes"
                        app:strokeColor="#6F6F6F"
                        app:strokeWidth="2dp"
                        />
                    <ImageView
                        android:id="@+id/ic_add_screenshots_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/outline_add_photo_alternate_24"
                        android:layout_marginTop="35dp"
                        app:layout_constraintTop_toTopOf="@+id/add_screenshots_3"
                        app:layout_constraintEnd_toEndOf="@+id/add_screenshots_3"
                        app:layout_constraintStart_toStartOf="@+id/add_screenshots_3"
                        />
                    <TextView
                        android:id="@+id/text_add_screenshots_3"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_screenshots"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        app:layout_constraintTop_toBottomOf="@+id/ic_add_screenshots_3"
                        app:layout_constraintEnd_toEndOf="@+id/ic_add_screenshots_3"
                        app:layout_constraintStart_toStartOf="@+id/ic_add_screenshots_3" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/which_device_support_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/which_device_does_it_support"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/layout_theme_screenshots"
                    app:layout_constraintStart_toStartOf="parent" />

                <Spinner
                    android:id="@+id/spinner_device_support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@drawable/background_text"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/which_device_support_text"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                android:layout_marginVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_2"
                >

                <TextView
                    android:id="@+id/text_about_user"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    android:text="@string/about_author"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/user_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/name"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_user"
                    app:layout_constraintStart_toStartOf="parent" />
                <EditText
                    android:id="@+id/edit_text_username"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="@string/hint_author"
                    android:textColorHint="#B6B6B6"
                    android:textColor="#FFFFFF"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:maxLength="40"
                    android:textSize="16sp"
                    android:paddingVertical="7dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/custom_background"
                    android:layout_marginTop="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_name_text"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerInside"
                    android:background="#373737"
                    android:src="@drawable/baseline_add_20"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="15dp"
                    android:padding="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_username"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#9E9E9E"
                    app:strokeWidth="1dp"
                    />

                <TextView
                    android:id="@+id/user_avatar_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_avatar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="@+id/user_avatar"
                    app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
                    app:layout_constraintStart_toEndOf="@+id/user_avatar"
                    />

                <Button
                    android:id="@+id/btn_send_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
