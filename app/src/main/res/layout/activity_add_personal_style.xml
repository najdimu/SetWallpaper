<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_personal_style_activity_layout"
    android:background="#1a1a1a"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".style_zone.activity.AddPersonalStyleActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_add_personal_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#272727"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestscroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_request_show">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/text_about_perStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_personal_style"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_perStyle" />

                <EditText
                    android:id="@+id/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/custom_background"
                    android:hint="@string/title"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#b6b6b6"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_text" />

                <TextView
                    android:id="@+id/description_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/description"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_title" />

                <EditText
                    android:id="@+id/edit_text_description"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/custom_background"
                    android:gravity="start"
                    android:hint="@string/hint_describe_style"
                    android:inputType="textMultiLine"
                    android:maxLines="10"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:textColor="#ffffff"
                    android:textColorHint="#b6b6b6"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_1">

                <TextView
                    android:id="@+id/text_about_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_content"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_source_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="15dp"
                    android:text="@string/theme"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_content" />

                <ImageView
                    android:id="@+id/btn_gone_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/delete_24px"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_theme"
                    app:layout_constraintStart_toEndOf="@+id/text_source_theme"
                    app:layout_constraintTop_toTopOf="@+id/text_source_theme" />

                <TextView
                    android:id="@+id/edit_text_source_theme"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/text_link_background"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:text="@string/hint_content_link"
                    android:textColor="#B6B6B6"
                    android:textSize="16sp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toStartOf="@+id/btn_paste_theme_link"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_theme" />

                <Button
                    android:id="@+id/btn_paste_theme_link"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:background="@drawable/paste_btn_background"
                    android:text="@string/paste"
                    android:textColor="#ffffff"
                    android:visibility="visible"
                    android:backgroundTint="@null"
                    app:layout_constraintBottom_toBottomOf="@+id/edit_text_source_theme"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/edit_text_source_theme" />

                <TextView
                    android:id="@+id/text_source_wallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/wallpaper"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_theme" />

                <ImageView
                    android:id="@+id/btn_gone_wall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/delete_24px"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_wallpaper"
                    app:layout_constraintStart_toEndOf="@+id/text_source_wallpaper"
                    app:layout_constraintTop_toTopOf="@+id/text_source_wallpaper" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/add_home_wall"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="15dp"
                    android:background="#373737"
                    android:padding="2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_add_20"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_wallpaper"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#9E9E9E"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/add_home_wall_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/add_home_wall"
                    android:textColor="#F6F6F6"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/add_home_wall"
                    app:layout_constraintStart_toEndOf="@+id/add_home_wall"
                    app:layout_constraintTop_toTopOf="@+id/add_home_wall" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/add_lock_wall"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    android:background="#373737"
                    android:padding="2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_add_20"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/add_home_wall"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#9E9E9E"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/add_lock_wall_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/add_lock_wall"
                    android:textColor="#F6F6F6"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/add_lock_wall"
                    app:layout_constraintStart_toEndOf="@+id/add_lock_wall"
                    app:layout_constraintTop_toTopOf="@+id/add_lock_wall" />

                <TextView
                    android:id="@+id/text_source_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/icon"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/add_lock_wall" />

                <ImageView
                    android:id="@+id/btn_gone_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/delete_24px"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_icon"
                    app:layout_constraintStart_toEndOf="@+id/text_source_icon"
                    app:layout_constraintTop_toTopOf="@+id/text_source_icon" />

                <TextView
                    android:id="@+id/edit_text_source_icon"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/text_link_background"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:text="@string/hint_content_link"
                    android:textColor="#B6B6B6"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/btn_paste_icon_link"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_icon" />

                <Button
                    android:id="@+id/btn_paste_icon_link"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:background="@drawable/paste_btn_background"
                    android:text="@string/paste"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:backgroundTint="@null"
                    app:layout_constraintBottom_toBottomOf="@+id/edit_text_source_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/edit_text_source_icon" />

                <TextView
                    android:id="@+id/text_source_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="15dp"
                    android:text="@string/font"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_icon" />

                <ImageView
                    android:id="@+id/btn_gone_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/delete_24px"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/text_source_font"
                    app:layout_constraintStart_toEndOf="@+id/text_source_font"
                    app:layout_constraintTop_toTopOf="@+id/text_source_font" />

                <TextView
                    android:id="@+id/edit_text_source_font"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/text_link_background"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:text="@string/hint_content_link"
                    android:textColor="#B6B6B6"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/btn_paste_font_link"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_source_font" />

                <Button
                    android:id="@+id/btn_paste_font_link"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:background="@drawable/paste_btn_background"
                    android:text="@string/paste"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:backgroundTint="@null"
                    app:layout_constraintBottom_toBottomOf="@+id/edit_text_source_font"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/edit_text_source_font" />

                <Spinner
                    android:id="@+id/spinner_type_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@drawable/background_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_source_font" />

                <TextView
                    android:id="@+id/error_text_type_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You must choose type content"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/spinner_type_content"
                    app:layout_constraintTop_toBottomOf="@+id/spinner_type_content" />

                <TextView
                    android:id="@+id/tv_screenshots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/content_screenshots"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/error_text_type_content" />

                <HorizontalScrollView
                    android:id="@+id/layout_screenshots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_screenshots">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:padding="5dp">

                        <TextView
                            android:id="@+id/text_screenshots_1"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:gravity="center"
                            android:text="@string/required_image_add"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@+id/add_screenshots_1"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_1"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_1" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/add_screenshots_1"
                            android:layout_width="100dp"
                            android:layout_height="206dp"
                            android:layout_marginTop="20dp"
                            android:background="#373737"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/home_screen"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/addImageThemes"
                            app:strokeColor="#6F6F6F"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:id="@+id/text_add_screenshots_1"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="50dp"
                            android:gravity="center"
                            android:text="@string/text_add_screenshots"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@+id/add_screenshots_1"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_1"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_1" />

                        <TextView
                            android:id="@+id/text_screenshots_2"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:gravity="center"
                            android:text="@string/required_image_add"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@+id/add_screenshots_2"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_2"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_2" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/add_screenshots_2"
                            android:layout_width="100dp"
                            android:layout_height="206dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="20dp"
                            android:background="#373737"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/lock_screen"
                            app:layout_constraintStart_toEndOf="@+id/add_screenshots_1"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/avatarThemes"
                            app:strokeColor="#6F6F6F"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:id="@+id/text_add_screenshots_2"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="50dp"
                            android:gravity="center"
                            android:text="@string/text_add_screenshots"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@+id/add_screenshots_2"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_2"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_2" />

                        <TextView
                            android:id="@+id/text_screenshots_3"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:gravity="center"
                            android:text="@string/optional_image_add"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@+id/add_screenshots_3"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_3"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_3" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/add_screenshots_3"
                            android:layout_width="100dp"
                            android:layout_height="206dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="20dp"
                            android:background="#373737"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/noti_panel"
                            app:layout_constraintStart_toEndOf="@+id/add_screenshots_2"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/avatarThemes"
                            app:strokeColor="#6F6F6F"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:id="@+id/text_add_screenshots_3"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="50dp"
                            android:gravity="center"
                            android:text="@string/text_add_screenshots"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@+id/add_screenshots_3"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_3"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_3" />

                        <TextView
                            android:id="@+id/text_screenshots_4"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:gravity="center"
                            android:text="@string/optional_image_add"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@+id/add_screenshots_4"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_4"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_4" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/add_screenshots_4"
                            android:layout_width="100dp"
                            android:layout_height="206dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="20dp"
                            android:background="#373737"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/setting"
                            app:layout_constraintStart_toEndOf="@+id/add_screenshots_3"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/avatarThemes"
                            app:strokeColor="#6F6F6F"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:id="@+id/text_add_screenshots_4"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="50dp"
                            android:gravity="center"
                            android:text="@string/text_add_screenshots"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@+id/add_screenshots_4"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_4"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_4" />

                        <TextView
                            android:id="@+id/text_screenshots_5"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:gravity="center"
                            android:text="@string/optional_image_add"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@+id/add_screenshots_5"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_5"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_5" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/add_screenshots_5"
                            android:layout_width="100dp"
                            android:layout_height="206dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="20dp"
                            android:background="#373737"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/dialing"
                            app:layout_constraintStart_toEndOf="@+id/add_screenshots_4"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/avatarThemes"
                            app:strokeColor="#6F6F6F"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:id="@+id/text_add_screenshots_5"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="50dp"
                            android:gravity="center"
                            android:text="@string/text_add_screenshots"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@+id/add_screenshots_5"
                            app:layout_constraintEnd_toEndOf="@+id/add_screenshots_5"
                            app:layout_constraintStart_toStartOf="@+id/add_screenshots_5" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </HorizontalScrollView>

                <TextView
                    android:id="@+id/which_device_support_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/which_device_does_it_support"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_screenshots" />

                <Spinner
                    android:id="@+id/spinner_device_support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@drawable/background_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/which_device_support_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/cons_background"
                android:padding="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_2">

                <TextView
                    android:id="@+id/text_about_user"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_author"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/user_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/name"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_about_user" />

                <EditText
                    android:id="@+id/edit_text_username"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/custom_background"
                    android:hint="@string/hint_author"
                    android:inputType="textCapWords"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B6B6B6"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_name_text" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="15dp"
                    android:background="#373737"
                    android:padding="2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_add_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_username"
                    app:shapeAppearanceOverlay="@style/avatarThemes"
                    app:strokeColor="#9E9E9E"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/user_avatar_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/add_avatar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
                    app:layout_constraintStart_toEndOf="@+id/user_avatar"
                    app:layout_constraintTop_toTopOf="@+id/user_avatar" />

                <Button
                    android:id="@+id/btn_send_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/send"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_text_username" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/btn_send_content"
                    app:layout_constraintEnd_toEndOf="@+id/btn_send_content"
                    app:layout_constraintStart_toStartOf="@+id/btn_send_content"
                    app:layout_constraintTop_toTopOf="@+id/btn_send_content" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/textView_request_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/request_text_background"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="Sen 5 sany ugratdyn"
        android:textColor="#ffffff"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/nestscroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_add_personal_style" />


</androidx.constraintlayout.widget.ConstraintLayout>